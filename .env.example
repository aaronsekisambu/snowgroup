# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional form endpoint (Formspree). Falls back to src/data/app.json settings.formspreeURL
NEXT_PUBLIC_FORMSPREE_URL=

# Mailchimp (also configurable in src/data/app.json)
NEXT_PUBLIC_MAILCHIMP_ACTION_URL=
NEXT_PUBLIC_MAILCHIMP_PUBLIC_KEY=
